{
  "name": "dom-to-r3f",
  "version": "0.1.0",
  "description": "A React library for converting DOM elements to React Three Fiber components",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "start": "react-scripts start",
    "build": "rollup -c",
    "build:lib": "rollup -c",
    "build:app": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "prepublishOnly": "npm run build:lib",
    "predeploy": "npm run build:app",
    "deploy": "gh-pages -d build"
  },
  "peerDependencies": {
    "@react-three/fiber": "^8.0.0",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "three": "^0.140.0"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "gh-pages": "^6.3.0",
    "react-scripts": "5.0.1",
    "styled-components": "^5.3.5",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^3.29.5",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "react",
    "three.js",
    "react-three-fiber",
    "dom",
    "3d",
    "webgl",
    "canvas"
  ],
  "author": "0xSandwich",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xsandwich/dom-to-r3f.git"
  },
  "bugs": {
    "url": "https://github.com/0xsandwich/dom-to-r3f/issues"
  },
  "homepage": "https://0xsandwich.github.io/dom-to-r3f",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
