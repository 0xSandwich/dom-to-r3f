import React, {
  ReactNode, useRef, useState,
} from 'react';
import { useCurtainsEvent, ShaderPass, FXAAPass } from 'react-curtains'
import { useSpring, animated } from '@react-spring/web';
import {
  firstPassFs, secondPassFs, firstPassUniforms, secondPassUniforms,
} from '../../assets/shaders/shaderPasses'

import { projectsData } from '../../assets/data';
import CardProject from '../ui/CardProject';
import Title from '../ui/Title';

const Projects = () => {
  interface projectProps {
    id: string;
    title: string;
    img: string;
    description: string;
    target:string
  }

  const [nbPlanes] = useState(projectsData.length)
  const [planes, setPlanes] = useState< any >([])
  const planesDeformations = useRef(0)

  useCurtainsEvent(
    'onRender',
    (curtains:{lerp:(target:{}, min:number, max:number)=>number}) => {
      // update our planes deformation
      // increase/decrease the effect
      planesDeformations.current = curtains.lerp(
        planesDeformations.current,
        0,
        0.075,
      );
      // update planes deformations
      planes.forEach((plane:any) => {
        plane.uniforms.planeDeformation.value = planesDeformations.current;
        plane.textures[0].scale.y = 1 + (planesDeformations.current / 300)
        plane.textures[0].scale.x = 1 + (planesDeformations.current / 300)
      });
    },
    [planes],
  );

  useCurtainsEvent('onScroll', (curtains:{getScrollDeltas:()=>{y:number}, lerp:(from:number, to:number, size:number)=>number}) => {
    // get scroll deltas to apply the effect on scroll
    const delta:{y:number} = curtains.getScrollDeltas();

    // invert value for the effect
    delta.y = -delta.y;

    // threshold
    if (delta.y > 60) {
      delta.y = 60;
    } else if (delta.y < -60) {
      delta.y = -60;
    }

    if (Math.abs(delta.y) > Math.abs(planesDeformations.current)) {
      planesDeformations.current = curtains.lerp(
        planesDeformations.current,
        delta.y,
        0.2,
      );
    }
  });

  const onPlaneReady = (plane:{uniforms:{planeDeformation:{value:number}}}) => {
    setPlanes((prev:any) => [...prev, plane])
  }

  const buildPlane = (project:projectProps, index:number) => (
    <CardProject
      key={project.title}
      id={project.id}
      title={project.title}
      image={project.img}
      target={project.target}
      isReverse={index % 2 !== 0}
      isLast={index === nbPlanes - 1}
      onPlaneReady={onPlaneReady}
    >
      {project.description}
    </CardProject>
  )

  const allPlanes:ReactNode[] = []
  projectsData.forEach((project, index) => {
    allPlanes.push(buildPlane(project, index))
  })

  // post processing

  const onFirstPassReady = (shaderPass:{loader:{loadImage:(url:string, options:{})=>void}}) => {
    shaderPass.loader.loadImage(
      'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRLf4ggd-BivWseEbfVSontKTPx5UWhPZI-RQ&usqp=CAU',
      {
        sampler: 'displacementTexture',
      },
    );
  };

  const onFirstPassRender = (shaderPass:{uniforms:{displacement:{value:number}}}) => {
    // update the uniforms
    shaderPass.uniforms.displacement.value = planesDeformations.current / 60;
  };

  const onSecondPassRender = (shaderPass:{uniforms:{displacementHover:{value:number}}}) => {
    // update the uniforms
    shaderPass.uniforms.displacementHover.value = 0 / 60;
  };

  return (
    <section className="container px-4 lg:px-0 mx-auto mt-80 mb-12 lg:mb-40">
      <Title styled="mb-12" sectionTitle>Projects</Title>
      <div className="flex flex-col">
        {allPlanes.map((planeEl) => planeEl)}
      </div>
      <FXAAPass />

      <ShaderPass
        fragmentShader={firstPassFs}
        uniforms={firstPassUniforms}
        onReady={onFirstPassReady}
        onRender={onFirstPassRender}
      />

      <ShaderPass
        fragmentShader={secondPassFs}
        uniforms={secondPassUniforms}
        onReady={onFirstPassReady}
        onRender={onSecondPassRender}
      />
    </section>
  )
}

export default Projects
